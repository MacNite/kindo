// Kindo database schema (§17, §19.2).
//
// One installation is one household (§20 D10), so there is no householdId on
// every row: the singleton `Household` holds the family-wide settings.
// User-entered text is stored as JSON (`Text` in src/lib/types.ts): a plain
// string, or `{ de, en }` for the bundled demo family.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  adult
  child
}

enum RewardMode {
  off
  stars
  tokens
  money
}

enum Period {
  morning
  afternoon
  evening
}

enum CompletionStatus {
  /// Ticked off and counted.
  done
  /// An extra waiting for a parent's OK (§9).
  pending
}

enum PointsReason {
  earn
  redeem
  adjust
}

enum CalendarProvider {
  caldav
  google
  ics
  local
}

enum ConnectionKind {
  caldav
  google
  ics
  immich
  homeassistant
}

enum ConnectionStatus {
  ok
  error
  pending
}

enum ImportantDateKind {
  birthday
  anniversary
  school
  other
}

model Household {
  id               Int        @id @default(1)
  name             String
  timezone         String     @default("Europe/Berlin")
  location         String?
  rewardMode       RewardMode @default(stars)
  /// Pocket-money mode: what one point is worth, in the region's currency.
  pointValue       Float      @default(0.05)
  /// Minutes without touch before the wall becomes a photo frame.
  idleMinutes      Float      @default(2)
  showPhotoMeta    Boolean    @default(true)
  /// `WidgetConfig[]`: which home cards show, their order and size.
  widgets          Json
  /// `WallTile[]`: which household tiles the wall display shows beside the lanes, in order (§4, §21).
  wallTiles        Json       @default("[]")
  /// HH:MM. The household day starts here, so a late evening tick still counts for that evening (§19.3).
  dayStartsAt      String     @default("03:00")
  /// HH:MM. Which routine the wall shows "now".
  morningUntil     String     @default("11:00")
  afternoonUntil   String     @default("17:00")
  /// School-holiday ICS feeds; school days are Monday to Friday minus their dates (§7).
  holidayIcsUrls   String[]   @default([])
  holidaysSyncedAt DateTime?
  holidaysError    String?
  /// Hash of the PIN that unlocks settings on a paired wall display (§19.4).
  settingsPinHash  String?
  /// Loaded from the bundled demo family (§20 D11).
  demo             Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Member {
  id             String   @id @default(cuid())
  name           String
  role           Role
  color          String
  /// `Member["avatar"]`: emoji, initial or photo.
  avatar         Json
  /// YYYY-MM-DD
  birthday       String?
  /// Routine steps earn points while this is on (§9, D42).
  routineRewards Boolean  @default(false)
  /// What a routine step earns when it sets no points of its own.
  routinePoints  Int      @default(5)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  /// People and logins are separate (§3): children never have one.
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  routines    Routine[]
  chores      Chore[]
  completions Completion[]
  points      PointsEntry[]
  tasks       Task[]
  shopping    ShoppingItem[]
  meals       Meal[]
  dates       ImportantDate[]
}

model Routine {
  id         String        @id @default(cuid())
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period     Period
  /// `Recurrence` (§7)
  recurrence Json
  sortOrder  Int           @default(0)
  steps      RoutineStep[]
  createdAt  DateTime      @default(now())
}

model RoutineStep {
  id        String  @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  position  Int
  pictogram String
  label     Json
  /// `TaskValue`: "expected" follows the member's routine points, an "extra" sets its own (§9, D42)
  value     Json

  @@index([routineId, position])
}

model Chore {
  id         String   @id @default(cuid())
  /// null = anyone
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pictogram  String
  label      Json
  value      Json
  recurrence Json
  createdAt  DateTime @default(now())
}

/// One routine step or chore, ticked off for one household day. Kept when the
/// step is edited or deleted, so it doubles as the completion history (§19.3).
model Completion {
  id         String           @id @default(cuid())
  /// RoutineStep.id or Chore.id. Deliberately no foreign key: history outlives edits.
  itemId     String
  /// Who did it. null for an "anyone" chore ticked on a shared screen.
  memberId   String?
  member     Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Household day, YYYY-MM-DD.
  day        String
  status     CompletionStatus
  /// Snapshot of the item when it was ticked, for history and approvals.
  pictogram  String
  label      Json
  value      Json
  at         DateTime         @default(now())
  resolvedAt DateTime?

  points PointsEntry?

  @@unique([itemId, day])
  @@index([day])
}

/// The points ledger. A member's balance is the sum of their entries.
model PointsEntry {
  id           String       @id @default(cuid())
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  delta        Int
  reason       PointsReason
  /// The extra that earned these points. Unticking it removes the entry.
  completionId String?      @unique
  completion   Completion?  @relation(fields: [completionId], references: [id], onDelete: Cascade)
  rewardId     String?
  at           DateTime     @default(now())

  @@index([memberId])
}

model Reward {
  id        String  @id @default(cuid())
  emoji     String
  title     Json
  cost      Int
  sortOrder Int     @default(0)
  archived  Boolean @default(false)
}

model Task {
  id        String    @id @default(cuid())
  title     Json
  memberId  String?
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  due       DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model ShoppingList {
  id        String         @id @default(cuid())
  name      Json
  icon      String
  sortOrder Int            @default(0)
  items     ShoppingItem[]
}

model ShoppingItem {
  id        String       @id @default(cuid())
  listId    String
  list      ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      Json
  qty       String?
  category  String
  memberId  String?
  member    Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  done      Boolean      @default(false)
  doneAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([listId])
}

model Meal {
  /// YYYY-MM-DD
  day    String  @id
  dinner Json
  cookId String?
  cook   Member? @relation(fields: [cookId], references: [id], onDelete: SetNull)
  note   Json?
}

model ImportantDate {
  id       String            @id @default(cuid())
  kind     ImportantDateKind
  title    Json
  /// YYYY-MM-DD. For yearly dates the original date (a birth or wedding), so
  /// the age can be counted.
  date     String
  yearly   Boolean           @default(true)
  memberId String?
  member   Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model CalendarSource {
  id               String           @id @default(cuid())
  provider         CalendarProvider
  name             Json
  /// Shown under the name, e.g. the server's host.
  account          String?
  /// Members whose colour the source's events take (§5).
  defaultMemberIds String[]
  readOnly         Boolean          @default(false)
  /// Every event of this source is daily attendance (school, Kita): shown quietly.
  background       Boolean          @default(false)
  sortOrder        Int              @default(0)
  /// Where the calendar lives; null for Kindo's own and the demo's.
  connectionId     String?
  connection       Connection?      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The calendar's address at its connection (a CalDAV collection URL, a Google calendar id).
  remoteId         String?
  /// Change marker from the last sync (CalDAV ctag), to skip unchanged calendars.
  syncState        String?
  lastSyncAt       DateTime?
  events           Event[]
}

model Event {
  id         String         @id @default(cuid())
  sourceId   String
  source     CalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title      Json
  start      DateTime
  end        DateTime
  /// All-day events store the date at UTC midnight.
  allDay     Boolean        @default(false)
  /// Empty = whole family.
  memberIds  String[]
  location   String?
  icon       String?
  background Boolean        @default(false)
  /// The iCalendar UID, and the object's address and version at its server.
  uid        String?
  href       String?
  etag       String?
  /// One occurrence of a recurring series: shown, but edited at the source.
  recurring  Boolean        @default(false)

  @@index([start])
  @@index([sourceId])
}

model PhotoAlbum {
  id           String       @id @default(cuid())
  /// Which photo server the album lives on, shown as its group heading.
  server       String
  name         String
  count        Int          @default(0)
  selected     Boolean      @default(false)
  /// Share of the rotation, relative to the other selected albums.
  weight       Int          @default(0)
  photos       PhotoAsset[]
  /// The Immich server the album lives on; null for the demo's drawn albums.
  connectionId String?
  connection   Connection?  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The album's id on its server.
  remoteId     String?
  syncedAt     DateTime?

  @@unique([connectionId, remoteId])
}

model PhotoAsset {
  id       String     @id @default(cuid())
  albumId  String
  album    PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  takenAt  DateTime?
  place    String?
  /// Demo photos are drawn, not fetched: the seed picks the picture.
  seed     Int?
  /// The asset's id on its Immich server; the image itself is proxied (§13).
  remoteId String?

  @@unique([albumId, remoteId])
  @@index([albumId])
}

/// A school holiday or public holiday from one of the household's holiday feeds (§7).
model HolidayRange {
  id      String @id @default(cuid())
  /// YYYY-MM-DD, inclusive.
  start   String
  /// YYYY-MM-DD, inclusive.
  end     String
  summary String
  feed    String

  @@index([end])
}

// ---------------------------------------------------------------------------
// Accounts (§19.4): Better Auth's tables, plus kiosk devices.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  member        Member?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A paired kiosk screen (the wall tablet). It needs no login: a long-lived,
/// revocable token in a cookie lets it show the wall and the child view.
model Device {
  id         String    @id @default(cuid())
  name       String
  /// SHA-256 of the device token; the token itself only lives in the device's cookie.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  pairedById String?
}

/// A wall display waiting to be paired: it shows `code`, an admin confirms it.
model PairingRequest {
  id         String    @id @default(cuid())
  code       String    @unique
  /// SHA-256 of the secret in the waiting device's cookie.
  secretHash String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  approvedAt DateTime?
  deviceName String?
  approvedBy String?
}

/// A connection to an outside service (§17): a Nextcloud account, a Google
/// account, an ICS feed, an Immich server, Home Assistant. Its secret (app
/// password, API key, refresh token, private feed URL) is encrypted with
/// KINDO_SECRET_KEY and never leaves the server.
model Connection {
  id         String           @id @default(cuid())
  kind       ConnectionKind
  name       String
  url        String?
  username   String?
  /// Encrypted (see src/server/crypto.ts).
  secret     String?
  /// Kind-specific settings, never secret.
  config     Json             @default("{}")
  status     ConnectionStatus @default(pending)
  lastError  String?
  lastSyncAt DateTime?
  createdAt  DateTime         @default(now())
  sources    CalendarSource[]
  albums     PhotoAlbum[]
}
