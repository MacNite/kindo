# ---------------------------------------------------------------------------
# Kindo configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Host port the app is published on.
APP_PORT=3000

# Prebuilt image from the "Publish image" workflow. Pin a version tag for a
# reproducible deployment, e.g. ghcr.io/macnite/kindo:0.1.0.
# Ignored by `docker compose up -d --build`.
APP_IMAGE=ghcr.io/macnite/kindo:latest

# Server time zone (logs, later background jobs and sync). The screens
# themselves use each device's own clock, so set the wall tablet's zone too.
TZ=Europe/Berlin
