# ---------------------------------------------------------------------------
# Kindo configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Host port the app is published on.
APP_PORT=3000

# Prebuilt images from the "Publish image" workflow. Pin the same version tag
# on both for a reproducible deployment, e.g. ghcr.io/macnite/kindo:0.2.0.
# Ignored by `docker compose up -d --build`.
APP_IMAGE=ghcr.io/macnite/kindo:latest
MIGRATE_IMAGE=ghcr.io/macnite/kindo-migrate:latest

# PostgreSQL. The password is required; the database is only reachable inside
# the compose network.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=kindo
# POSTGRES_DB=kindo
# POSTGRES_DATA_PATH=./data/postgres

# Only outside Docker (`npm run dev`, `npm start`, migrations from a checkout).
# Compose builds DATABASE_URL itself from the POSTGRES_* values above and
# ignores this one.
# DATABASE_URL=postgresql://kindo:kindo@localhost:5432/kindo

# Household time zone for the server (background sync, the daily reset). The
# screens use each device's own clock, so set the wall tablet's zone too.
TZ=Europe/Berlin

# Required. Signs sessions and wall-display cookies and encrypts the passwords
# and API keys of integrations. Generate once and keep it: changing it signs
# everyone out and makes stored integration secrets unreadable.
#   openssl rand -base64 32
KINDO_SECRET_KEY=
# Lets a production build start without KINDO_SECRET_KEY, using a built-in
# development key that is public. Only for throwaway local runs, never for a
# real household.
# KINDO_ALLOW_DEV_SECRET=false

# The address the family opens Kindo at. Recommended: it sets the sign-in
# callback URLs and, for https://, Secure cookies. Further addresses (e.g. a
# LAN IP next to the hostname) go into KINDO_TRUSTED_ORIGINS, comma-separated.
# APP_URL=https://kindo.example.home
# KINDO_TRUSTED_ORIGINS=http://192.168.1.20:3000

# Set to true only when Kindo is reached through a reverse proxy (Traefik,
# Caddy, nginx) that sets X-Forwarded-For and is the only way in. Kindo then
# limits sign-in attempts and pairing per client address as well as per
# email. Without a proxy, leave it off: anyone could write that header.
# KINDO_TRUST_PROXY=false

# Single sign-on with authentik or any OpenID Connect provider. Redirect URI:
#   <APP_URL>/api/auth/callback/oidc
# Only people with a login (created by an admin) can sign in this way.
# OIDC_ISSUER=https://auth.example.home/application/o/kindo/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=authentik
# Set to false to allow only single sign-on: no password fields anywhere, and
# first-run setup asks only for the admin's email. Ignored (with a warning in
# the log) while single sign-on isn't set up, so you can't lock yourself out.
# KINDO_PASSWORD_LOGIN=true

# Google Calendar: the household's own OAuth client (Google Cloud console,
# type "Web application", Calendar API enabled). Redirect URI:
#   <APP_URL>/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# How often connected calendars (Nextcloud, subscriptions, Google) are synced, in minutes.
# KINDO_SYNC_MINUTES=5

# Disk space for proxied Immich photos, in MB (least recently shown go first).
# KINDO_PHOTO_CACHE_MB=500
# Where the photo cache lives. The image sets /data/cache (the kindo-cache
# volume); outside Docker it defaults to ./data/cache.
# KINDO_CACHE_DIR=/data/cache

# Background jobs (holiday feeds, calendar, contact and photo sync, Home
# Assistant presence and doorbell) run in the app; with several app
# containers one of them leads. "off" stops them in this process.
# KINDO_JOBS=on

# Log detail: debug, info, warn or error. One JSON line per entry.
# LOG_LEVEL=info

# Load the Müller demo family into an empty database on first start.
# KINDO_DEMO=true
